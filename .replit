modules = ["python-base-3.13", "nodejs-24"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm exec next dev --port 5000 --hostname 0.0.0.0"
waitForPort = 5000

[deployment]
deploymentTarget = "autoscale"
run = ["pnpm", "exec", "next", "start", "--port", "5000", "--hostname", "0.0.0.0"]
build = ["pnpm", "build"]
